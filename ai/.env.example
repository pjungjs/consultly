# Template only: copy to .env (git-ignored) and put real values there, never in this file.

# Optional. Without it the service still reads PDFs and the Help chat answers in demo mode.
ANTHROPIC_API_KEY=

# Optional. Which Claude model the briefs and the Help chat use. Default: claude-haiku-5-5 (cheapest).
# Other choices: claude-sonnet-5-5 (stronger, ~20x the price), claude-opus-5-5 (strongest).
CLAUDE_MODEL=

# Deployed only: the API's address (for the Help chat's bookings lookup) and the shared secret it sends.
API_URL=
AI_SERVICE_TOKEN=
