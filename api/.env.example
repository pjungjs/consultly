DATABASE_URL="postgresql://USER@127.0.0.1:5432/consultly"
PORT=4000
WEB_URL="http://localhost:3000"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_... (printed by: stripe listen --forward-to localhost:4000/stripe/webhook)"
RESEND_API_KEY="re_... (optional: without it, sign-in links are printed in the API console)"
EMAIL_FROM="Consultly <onboarding@resend.dev>"
DEMO_CONSULTANT_EMAIL="you@example.com (optional: seeds Jason Jefferson with this email so you can sign in as him)"

# PDF briefs and the Help chat: URL of the Python AI service (ai/).
AI_URL=http://127.0.0.1:8000
# Where uploaded brief PDFs are stored (default: ./uploads, git-ignored).
UPLOAD_DIR=
# Your own address, so `npm run seed:briefs` can attach the sample brief to your bookings.
DEMO_CLIENT_EMAIL=

# Deployed only: PDF storage in a private Supabase Storage bucket (without these, PDFs go to UPLOAD_DIR on disk).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=briefs
# Deployed only: shared secret the AI service requires (set the same value in ai/.env).
AI_SERVICE_TOKEN=
# "true" shows "Try the demo" sign-in (a private demo client + copy of Jason per visitor) for the deployed portfolio site.
DEMO_LOGIN=
# Daily caps on Claude calls (defaults 200 chat answers, 30 briefs).
AI_DAILY_CHAT_LIMIT=
AI_DAILY_BRIEF_LIMIT=
